# ====================================================================
# PROJECT JARVIS — ENVIRONMENT CONFIGURATION (.env.example)
# Rename this file to .env and insert your real credentials if desired.
# Note: JARVIS includes an intelligent offline companion engine, so
# it runs and chats immediately even without API keys!
# ====================================================================

# Google Gemini API Key (Recommended for high intelligence & reasoning)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI / Groq / DeepSeek / Ollama API Key
# For local Ollama, you can leave key empty or set to 'ollama'
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred Default LLM Provider: 'gemini', 'openai', or 'offline'
DEFAULT_LLM_PROVIDER=gemini

# User Profile
USER_NAME=Rehan Raza
PREFERRED_ADDRESS=Rehan bhai
DEFAULT_LANGUAGE=Hinglish
